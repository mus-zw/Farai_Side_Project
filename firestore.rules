rules_version = '2';

// Fitness app cloud data. Each signed-in user can read and write ONLY their own area,
// users/{their uid}/..., which holds their profile, plan, workouts and sets, meals,
// weigh-ins and pinned cues. Everything else is denied (Firestore's default).
//
// Deploy:  npx firebase-tools deploy --only firestore:rules   (after `firebase login`
// and selecting your project with `firebase use <project-id>`).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
