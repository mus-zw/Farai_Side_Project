{
  "headers": [
    { "source": "/fitness-sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/fitness.webmanifest", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Content-Type", "value": "application/manifest+json" }] }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
